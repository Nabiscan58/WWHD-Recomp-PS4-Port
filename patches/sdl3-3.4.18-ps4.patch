diff -ruN a/src/joystick/ps4/SDL_ps4joystick.c SDL3-3.4.18/src/joystick/ps4/SDL_ps4joystick.c
--- a/src/joystick/ps4/SDL_ps4joystick.c	1970-01-01 01:00:00.000000000 +0100
+++ b/src/joystick/ps4/SDL_ps4joystick.c	2026-11-06 19:04:37.996872232 +0100
@@ -0,0 +1,500 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+
+/* PS4 homebrew: one joystick per signed-in user with a DualShock 4 (ScePad), up to four.
+
+   Reported as a Sony DualShock 4 (USB IDs 054c:09cc), so SDL's gamepad layer names it a PS4 controller (Cross,
+   Circle, ... button labels) with this driver's own mapping. The motion sensors (accelerometer and gyro) and the
+   touchpad are reported too. Apps can't read the PS button or SHARE on a PS4; instead:
+     - touchpad click   -> back (the "-" / Select button)
+     - L3 + R3 together -> guide (Home): opens most applications' own menu; L3 and R3 read as released meanwhile */
+#include "SDL_internal.h"
+
+#if defined(SDL_JOYSTICK_PRIVATE) && defined(SDL_PLATFORM_PS4_HOMEBREW)
+
+#include "../SDL_sysjoystick.h"
+#include "../SDL_joystick_c.h"
+#include "../usb_ids.h"
+
+#include <orbis/Pad.h>
+#include <orbis/UserService.h>
+
+#define PS4_MAX_PADS 4
+
+/* the touchpad's coordinate range (CUH-ZCT1/ZCT2) */
+#define PS4_TOUCH_W 1920.0f
+#define PS4_TOUCH_H 942.0f
+
+enum
+{
+    BTN_CROSS,
+    BTN_CIRCLE,
+    BTN_SQUARE,
+    BTN_TRIANGLE,
+    BTN_BACK, /* touchpad click */
+    BTN_GUIDE, /* L3 + R3 */
+    BTN_START, /* OPTIONS */
+    BTN_L3,
+    BTN_R3,
+    BTN_L1,
+    BTN_R1,
+    BTN_UP,
+    BTN_DOWN,
+    BTN_LEFT,
+    BTN_RIGHT,
+    BTN_TOUCHPAD, /* touchpad click, again as the gamepad's touchpad button */
+    BTN_COUNT
+};
+
+enum
+{
+    AXIS_LX,
+    AXIS_LY,
+    AXIS_RX,
+    AXIS_RY,
+    AXIS_L2,
+    AXIS_R2,
+    AXIS_COUNT
+};
+
+typedef struct PS4Pad
+{
+    int user;   /* OrbisUserServiceUserId, -1: free slot */
+    int handle; /* scePadOpen */
+    SDL_JoystickID instance;
+    bool sensors;
+    SDL_Joystick *joystick;
+    Uint64 last_read_ns; /* PS4_JoystickUpdate: scePadReadState at most every PS4_READ_INTERVAL_NS */
+} PS4Pad;
+
+/* The DS4 reports at 250 Hz; SDL's event loop updates joysticks far more often (the game's main loop: about a
+   thousand times a second), and each scePadReadState is a call into the system: 21% of a core in WWHD-PS4 0.1.8's
+   profile. Reading once per report period changes nothing for the game. */
+#define PS4_READ_INTERVAL_NS (4 * SDL_NS_PER_MS)
+
+static PS4Pad PS4_pads[PS4_MAX_PADS];
+static int PS4_initial_user = -1;
+static Uint64 PS4_last_scan = 0;
+
+static int PS4_CountPads(void)
+{
+    int i, n = 0;
+    for (i = 0; i < PS4_MAX_PADS; i++) {
+        if (PS4_pads[i].handle >= 0) {
+            n++;
+        }
+    }
+    return n;
+}
+
+/* device_index -> slot (device indexes count the open slots in order) */
+static PS4Pad *PS4_PadAt(int device_index)
+{
+    int i;
+    for (i = 0; i < PS4_MAX_PADS; i++) {
+        if (PS4_pads[i].handle >= 0 && device_index-- == 0) {
+            return &PS4_pads[i];
+        }
+    }
+    return NULL;
+}
+
+static bool PS4_SignedIn(const OrbisUserServiceLoginUserIdList *list, int user)
+{
+    int i;
+    for (i = 0; i < ORBIS_USER_SERVICE_MAX_LOGIN_USERS; i++) {
+        if (list->userId[i] == user) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void PS4_OpenPad(int slot, int user)
+{
+    PS4Pad *p = &PS4_pads[slot];
+    int handle = scePadOpen(user, ORBIS_PAD_PORT_TYPE_STANDARD, 0, NULL);
+    if (handle < 0) {
+        return; /* that user has no controller (yet): the next scan tries again */
+    }
+    p->user = user;
+    p->handle = handle;
+    p->instance = SDL_GetNextObjectID();
+    p->sensors = false;
+    p->joystick = NULL;
+    SDL_PrivateJoystickAdded(p->instance);
+}
+
+/* Users who signed out lose their pad; signed-in users get the first free slot. The slot of the user who started
+   the application is the first one. */
+static void PS4_ScanPads(void)
+{
+    OrbisUserServiceLoginUserIdList list;
+    int i, k;
+
+    SDL_zero(list);
+    if (sceUserServiceGetLoginUserIdList(&list) != 0) {
+        return;
+    }
+    for (k = 0; k < PS4_MAX_PADS; k++) {
+        PS4Pad *p = &PS4_pads[k];
+        if (p->handle >= 0 && !PS4_SignedIn(&list, p->user)) {
+            SDL_JoystickID id = p->instance;
+            scePadClose(p->handle);
+            p->handle = -1;
+            p->user = -1;
+            SDL_PrivateJoystickRemoved(id);
+        }
+    }
+    if (PS4_pads[0].handle < 0 && PS4_initial_user >= 0 && PS4_SignedIn(&list, PS4_initial_user)) {
+        PS4_OpenPad(0, PS4_initial_user);
+    }
+    for (i = 0; i < ORBIS_USER_SERVICE_MAX_LOGIN_USERS; i++) {
+        int user = list.userId[i];
+        bool known = false;
+        if (user == -1 || user == 0) {
+            continue;
+        }
+        for (k = 0; k < PS4_MAX_PADS; k++) {
+            known |= PS4_pads[k].handle >= 0 && PS4_pads[k].user == user;
+        }
+        if (known) {
+            continue;
+        }
+        for (k = (user == PS4_initial_user) ? 0 : 1; k < PS4_MAX_PADS; k++) {
+            if (PS4_pads[k].handle < 0) {
+                PS4_OpenPad(k, user);
+                break;
+            }
+        }
+    }
+}
+
+static bool PS4_JoystickInit(void)
+{
+    int k;
+    for (k = 0; k < PS4_MAX_PADS; k++) {
+        PS4_pads[k].user = -1;
+        PS4_pads[k].handle = -1;
+    }
+    sceUserServiceInitialize(NULL); /* already initialized is fine */
+    if (scePadInit() != 0) {
+        return SDL_SetError("scePadInit failed");
+    }
+    if (sceUserServiceGetInitialUser(&PS4_initial_user) != 0) {
+        PS4_initial_user = -1;
+    }
+    PS4_ScanPads();
+    PS4_last_scan = SDL_GetTicks();
+    return true;
+}
+
+static int PS4_JoystickGetCount(void)
+{
+    return PS4_CountPads();
+}
+
+static void PS4_JoystickDetect(void)
+{
+    const Uint64 now = SDL_GetTicks();
+    if (now - PS4_last_scan >= 2000) { /* sign-ins, sign-outs, controllers turned on */
+        PS4_last_scan = now;
+        PS4_ScanPads();
+    }
+}
+
+static bool PS4_JoystickIsDevicePresent(Uint16 vendor_id, Uint16 product_id, Uint16 version, const char *name)
+{
+    return false;
+}
+
+static const char *PS4_JoystickGetDeviceName(int device_index)
+{
+    return "DualShock 4 (PS4)";
+}
+
+static const char *PS4_JoystickGetDevicePath(int device_index)
+{
+    return NULL;
+}
+
+static int PS4_JoystickGetDeviceSteamVirtualGamepadSlot(int device_index)
+{
+    return -1;
+}
+
+static int PS4_JoystickGetDevicePlayerIndex(int device_index)
+{
+    PS4Pad *p = PS4_PadAt(device_index);
+    return p ? (int)(p - PS4_pads) : -1;
+}
+
+static void PS4_JoystickSetDevicePlayerIndex(int device_index, int player_index)
+{
+}
+
+static SDL_GUID PS4_JoystickGetDeviceGUID(int device_index)
+{
+    return SDL_CreateJoystickGUID(SDL_HARDWARE_BUS_USB, USB_VENDOR_SONY, USB_PRODUCT_SONY_DS4_SLIM, 0x0100, "Sony",
+                                  "DualShock 4 (PS4)", 'p', 4);
+}
+
+static SDL_JoystickID PS4_JoystickGetDeviceInstanceID(int device_index)
+{
+    PS4Pad *p = PS4_PadAt(device_index);
+    return p ? p->instance : 0;
+}
+
+static bool PS4_JoystickOpen(SDL_Joystick *joystick, int device_index)
+{
+    PS4Pad *p = PS4_PadAt(device_index);
+    if (!p) {
+        return SDL_SetError("No such PS4 controller");
+    }
+    joystick->hwdata = (struct joystick_hwdata *)p;
+    joystick->nbuttons = BTN_COUNT;
+    joystick->naxes = AXIS_COUNT;
+    joystick->nhats = 0;
+    p->joystick = joystick;
+    SDL_PrivateJoystickAddTouchpad(joystick, ORBIS_PAD_MAX_TOUCH_NUM);
+    SDL_PrivateJoystickAddSensor(joystick, SDL_SENSOR_GYRO, 250.0f);
+    SDL_PrivateJoystickAddSensor(joystick, SDL_SENSOR_ACCEL, 250.0f);
+    SDL_SetBooleanProperty(SDL_GetJoystickProperties(joystick), SDL_PROP_JOYSTICK_CAP_RUMBLE_BOOLEAN, true);
+    SDL_SetBooleanProperty(SDL_GetJoystickProperties(joystick), SDL_PROP_JOYSTICK_CAP_RGB_LED_BOOLEAN, true);
+    return true;
+}
+
+static bool PS4_JoystickRumble(SDL_Joystick *joystick, Uint16 low_frequency_rumble, Uint16 high_frequency_rumble)
+{
+    PS4Pad *p = (PS4Pad *)joystick->hwdata;
+    OrbisPadVibeParam v;
+    if (!p || p->handle < 0) {
+        return SDL_SetError("Controller is gone");
+    }
+    v.lgMotor = (Uint8)(low_frequency_rumble >> 8);
+    v.smMotor = (Uint8)(high_frequency_rumble >> 8);
+    return scePadSetVibration(p->handle, &v) == 0 ? true : SDL_SetError("scePadSetVibration failed");
+}
+
+static bool PS4_JoystickRumbleTriggers(SDL_Joystick *joystick, Uint16 left_rumble, Uint16 right_rumble)
+{
+    return SDL_Unsupported();
+}
+
+static bool PS4_JoystickSetLED(SDL_Joystick *joystick, Uint8 red, Uint8 green, Uint8 blue)
+{
+    PS4Pad *p = (PS4Pad *)joystick->hwdata;
+    OrbisPadColor c;
+    if (!p || p->handle < 0) {
+        return SDL_SetError("Controller is gone");
+    }
+    c.r = red;
+    c.g = green;
+    c.b = blue;
+    c.a = 255;
+    return scePadSetLightBar(p->handle, &c) == 0 ? true : SDL_SetError("scePadSetLightBar failed");
+}
+
+static bool PS4_JoystickSendEffect(SDL_Joystick *joystick, const void *data, int size)
+{
+    return SDL_Unsupported();
+}
+
+static bool PS4_JoystickSetSensorsEnabled(SDL_Joystick *joystick, bool enabled)
+{
+    PS4Pad *p = (PS4Pad *)joystick->hwdata;
+    if (p) {
+        p->sensors = enabled;
+    }
+    return true;
+}
+
+static Sint16 PS4_Stick(Uint8 v)
+{
+    int s = ((int)v - 128) * 258; /* -33024..32766 */
+    if (s < SDL_JOYSTICK_AXIS_MIN) {
+        s = SDL_JOYSTICK_AXIS_MIN;
+    }
+    if (s > SDL_JOYSTICK_AXIS_MAX) {
+        s = SDL_JOYSTICK_AXIS_MAX;
+    }
+    return (Sint16)s;
+}
+
+static Sint16 PS4_Trigger(Uint8 v)
+{
+    return (Sint16)(((int)v * 257) - 32768); /* full axis range: the gamepad layer makes it 0..32767 */
+}
+
+static void PS4_JoystickUpdate(SDL_Joystick *joystick)
+{
+    PS4Pad *p = (PS4Pad *)joystick->hwdata;
+    OrbisPadData d;
+    Uint64 timestamp;
+    unsigned int b;
+    bool both_sticks;
+    int f;
+
+    if (!p || p->handle < 0) {
+        return;
+    }
+    timestamp = SDL_GetTicksNS();
+    if (timestamp - p->last_read_ns < PS4_READ_INTERVAL_NS) {
+        return;
+    }
+    p->last_read_ns = timestamp;
+    SDL_zero(d);
+    if (scePadReadState(p->handle, &d) != 0 || !d.connected) {
+        return;
+    }
+    b = d.buttons;
+    both_sticks = (b & (ORBIS_PAD_BUTTON_L3 | ORBIS_PAD_BUTTON_R3)) == (ORBIS_PAD_BUTTON_L3 | ORBIS_PAD_BUTTON_R3);
+
+    SDL_SendJoystickButton(timestamp, joystick, BTN_CROSS, (b & ORBIS_PAD_BUTTON_CROSS) != 0);
+    SDL_SendJoystickButton(timestamp, joystick, BTN_CIRCLE, (b & ORBIS_PAD_BUTTON_CIRCLE) != 0);
+    SDL_SendJoystickButton(timestamp, joystick, BTN_SQUARE, (b & ORBIS_PAD_BUTTON_SQUARE) != 0);
+    SDL_SendJoystickButton(timestamp, joystick, BTN_TRIANGLE, (b & ORBIS_PAD_BUTTON_TRIANGLE) != 0);
+    SDL_SendJoystickButton(timestamp, joystick, BTN_BACK, (b & ORBIS_PAD_BUTTON_TOUCH_PAD) != 0);
+    SDL_SendJoystickButton(timestamp, joystick, BTN_GUIDE, both_sticks);
+    SDL_SendJoystickButton(timestamp, joystick, BTN_START, (b & ORBIS_PAD_BUTTON_OPTIONS) != 0);
+    SDL_SendJoystickButton(timestamp, joystick, BTN_L3, !both_sticks && (b & ORBIS_PAD_BUTTON_L3) != 0);
+    SDL_SendJoystickButton(timestamp, joystick, BTN_R3, !both_sticks && (b & ORBIS_PAD_BUTTON_R3) != 0);
+    SDL_SendJoystickButton(timestamp, joystick, BTN_L1, (b & ORBIS_PAD_BUTTON_L1) != 0);
+    SDL_SendJoystickButton(timestamp, joystick, BTN_R1, (b & ORBIS_PAD_BUTTON_R1) != 0);
+    SDL_SendJoystickButton(timestamp, joystick, BTN_UP, (b & ORBIS_PAD_BUTTON_UP) != 0);
+    SDL_SendJoystickButton(timestamp, joystick, BTN_DOWN, (b & ORBIS_PAD_BUTTON_DOWN) != 0);
+    SDL_SendJoystickButton(timestamp, joystick, BTN_LEFT, (b & ORBIS_PAD_BUTTON_LEFT) != 0);
+    SDL_SendJoystickButton(timestamp, joystick, BTN_RIGHT, (b & ORBIS_PAD_BUTTON_RIGHT) != 0);
+    SDL_SendJoystickButton(timestamp, joystick, BTN_TOUCHPAD, (b & ORBIS_PAD_BUTTON_TOUCH_PAD) != 0);
+
+    SDL_SendJoystickAxis(timestamp, joystick, AXIS_LX, PS4_Stick(d.leftStick.x));
+    SDL_SendJoystickAxis(timestamp, joystick, AXIS_LY, PS4_Stick(d.leftStick.y)); /* down positive, as SDL */
+    SDL_SendJoystickAxis(timestamp, joystick, AXIS_RX, PS4_Stick(d.rightStick.x));
+    SDL_SendJoystickAxis(timestamp, joystick, AXIS_RY, PS4_Stick(d.rightStick.y));
+    SDL_SendJoystickAxis(timestamp, joystick, AXIS_L2, PS4_Trigger(d.analogButtons.l2));
+    SDL_SendJoystickAxis(timestamp, joystick, AXIS_R2, PS4_Trigger(d.analogButtons.r2));
+
+    for (f = 0; f < ORBIS_PAD_MAX_TOUCH_NUM; f++) {
+        const bool down = f < d.touch.fingers;
+        float x = 0.0f, y = 0.0f;
+        if (down) {
+            x = SDL_clamp((float)d.touch.touch[f].x / PS4_TOUCH_W, 0.0f, 1.0f);
+            y = SDL_clamp((float)d.touch.touch[f].y / PS4_TOUCH_H, 0.0f, 1.0f);
+        }
+        SDL_SendJoystickTouchpad(timestamp, joystick, 0, f, down, x, y, down ? 1.0f : 0.0f);
+    }
+
+    if (p->sensors) {
+        /* scePadReadState: angular velocity in rad/s, acceleration in g */
+        const float gyro[3] = { d.vel.x, d.vel.y, d.vel.z };
+        const float accel[3] = { d.acell.x * SDL_STANDARD_GRAVITY, d.acell.y * SDL_STANDARD_GRAVITY,
+                                 d.acell.z * SDL_STANDARD_GRAVITY };
+        const Uint64 sensor_ts = d.timestamp * SDL_NS_PER_US;
+        SDL_SendJoystickSensor(timestamp, joystick, SDL_SENSOR_GYRO, sensor_ts, gyro, 3);
+        SDL_SendJoystickSensor(timestamp, joystick, SDL_SENSOR_ACCEL, sensor_ts, accel, 3);
+    }
+}
+
+static void PS4_JoystickClose(SDL_Joystick *joystick)
+{
+    PS4Pad *p = (PS4Pad *)joystick->hwdata;
+    if (p) {
+        p->joystick = NULL;
+        if (p->handle >= 0) {
+            OrbisPadVibeParam off = { 0, 0 };
+            scePadSetVibration(p->handle, &off);
+            scePadResetLightBar(p->handle);
+        }
+    }
+    joystick->hwdata = NULL;
+}
+
+static void PS4_JoystickQuit(void)
+{
+    int k;
+    for (k = 0; k < PS4_MAX_PADS; k++) {
+        if (PS4_pads[k].handle >= 0) {
+            scePadClose(PS4_pads[k].handle);
+        }
+        PS4_pads[k].handle = -1;
+        PS4_pads[k].user = -1;
+    }
+}
+
+static bool PS4_JoystickGetGamepadMapping(int device_index, SDL_GamepadMapping *out)
+{
+    *out = (SDL_GamepadMapping){
+        .a = { EMappingKind_Button, BTN_CROSS },
+        .b = { EMappingKind_Button, BTN_CIRCLE },
+        .x = { EMappingKind_Button, BTN_SQUARE },
+        .y = { EMappingKind_Button, BTN_TRIANGLE },
+        .back = { EMappingKind_Button, BTN_BACK },
+        .guide = { EMappingKind_Button, BTN_GUIDE },
+        .start = { EMappingKind_Button, BTN_START },
+        .leftstick = { EMappingKind_Button, BTN_L3 },
+        .rightstick = { EMappingKind_Button, BTN_R3 },
+        .leftshoulder = { EMappingKind_Button, BTN_L1 },
+        .rightshoulder = { EMappingKind_Button, BTN_R1 },
+        .dpup = { EMappingKind_Button, BTN_UP },
+        .dpdown = { EMappingKind_Button, BTN_DOWN },
+        .dpleft = { EMappingKind_Button, BTN_LEFT },
+        .dpright = { EMappingKind_Button, BTN_RIGHT },
+        .misc1 = { EMappingKind_None, 255 },
+        .touchpad = { EMappingKind_Button, BTN_TOUCHPAD },
+        .right_paddle1 = { EMappingKind_None, 255 },
+        .left_paddle1 = { EMappingKind_None, 255 },
+        .right_paddle2 = { EMappingKind_None, 255 },
+        .left_paddle2 = { EMappingKind_None, 255 },
+        .leftx = { EMappingKind_Axis, AXIS_LX },
+        .lefty = { EMappingKind_Axis, AXIS_LY },
+        .rightx = { EMappingKind_Axis, AXIS_RX },
+        .righty = { EMappingKind_Axis, AXIS_RY },
+        .lefttrigger = { EMappingKind_Axis, AXIS_L2 },
+        .righttrigger = { EMappingKind_Axis, AXIS_R2 },
+    };
+    return true;
+}
+
+SDL_JoystickDriver SDL_PRIVATE_JoystickDriver = {
+    PS4_JoystickInit,
+    PS4_JoystickGetCount,
+    PS4_JoystickDetect,
+    PS4_JoystickIsDevicePresent,
+    PS4_JoystickGetDeviceName,
+    PS4_JoystickGetDevicePath,
+    PS4_JoystickGetDeviceSteamVirtualGamepadSlot,
+    PS4_JoystickGetDevicePlayerIndex,
+    PS4_JoystickSetDevicePlayerIndex,
+    PS4_JoystickGetDeviceGUID,
+    PS4_JoystickGetDeviceInstanceID,
+    PS4_JoystickOpen,
+    PS4_JoystickRumble,
+    PS4_JoystickRumbleTriggers,
+    PS4_JoystickSetLED,
+    PS4_JoystickSendEffect,
+    PS4_JoystickSetSensorsEnabled,
+    PS4_JoystickUpdate,
+    PS4_JoystickClose,
+    PS4_JoystickQuit,
+    PS4_JoystickGetGamepadMapping
+};
+
+#endif /* SDL_JOYSTICK_PRIVATE && SDL_PLATFORM_PS4_HOMEBREW */

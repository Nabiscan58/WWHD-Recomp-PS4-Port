+/* PS4 homebrew (OpenOrbis toolchain, GoldHEN): one 1920x1080 fullscreen "window" on VideoOut.
+
+   There is no Vulkan loader on the PS4. The application links Mesa's RADV (ported to the PS4's GPU) and a small
+   window system integration layer that adds VK_KHR_surface, VK_EXT_headless_surface and VK_KHR_swapchain on
+   VideoOut; it hands SDL its vkGetInstanceProcAddr through SDL_PS4_GetVkGetInstanceProcAddr() (a weak symbol: an
+   application without one gets "Vulkan not supported"). Windows are surfaces of that layer, created with
+   vkCreateHeadlessSurfaceEXT. Input comes from the joystick driver (ScePad); there is no keyboard or mouse. */
+#include "SDL_internal.h"
+
+#if defined(SDL_VIDEO_DRIVER_PRIVATE) && defined(SDL_PLATFORM_PS4_HOMEBREW)
+
+#include "../SDL_sysvideo.h"
+#include "../SDL_vulkan_internal.h"
+#include "../../events/SDL_events_c.h"
+#include "../../events/SDL_keyboard_c.h"
+#include "../../events/SDL_mouse_c.h"
+
+#define PS4VID_DRIVER_NAME "ps4"
+#define PS4_SCREEN_W       1920
+#define PS4_SCREEN_H       1080
+
+/* provided by the application (its VideoOut WSI over the statically linked RADV) */
+extern void *SDL_PS4_GetVkGetInstanceProcAddr(void) __attribute__((weak));
+
+static SDL_Window *PS4_fullscreen_window = NULL;
+
+static bool PS4_VideoInit(SDL_VideoDevice *_this)
+{
+    SDL_DisplayMode mode;
+    SDL_zero(mode);
+    mode.format = SDL_PIXELFORMAT_ABGR8888; /* VideoOut A8B8G8R8 */
+    mode.w = PS4_SCREEN_W;
+    mode.h = PS4_SCREEN_H;
+    mode.refresh_rate = 60.0f;
+    if (SDL_AddBasicVideoDisplay(&mode) == 0) {
+        return false;
+    }
+    /* no keyboard and no mouse: the DualShock 4 comes through the joystick subsystem */
+    return true;
+}
+
+static void PS4_VideoQuit(SDL_VideoDevice *_this)
+{
+    PS4_fullscreen_window = NULL;
+}
+
+static void PS4_PumpEvents(SDL_VideoDevice *_this)
+{
+    /* nothing: the pads are polled by the joystick driver */
+}
+
+static bool PS4_CreateWindow(SDL_VideoDevice *_this, SDL_Window *window, SDL_PropertiesID create_props)
+{
+    /* every window is the whole screen */
+    window->x = 0;
+    window->y = 0;
+    window->w = window->windowed.w = window->floating.w = PS4_SCREEN_W;
+    window->h = window->windowed.h = window->floating.h = PS4_SCREEN_H;
+    window->flags |= SDL_WINDOW_FULLSCREEN | SDL_WINDOW_INPUT_FOCUS | SDL_WINDOW_MOUSE_FOCUS;
+    window->flags &= ~(SDL_WINDOW_RESIZABLE | SDL_WINDOW_HIGH_PIXEL_DENSITY);
+    if (!PS4_fullscreen_window) {
+        PS4_fullscreen_window = window;
+    }
+    SDL_SetKeyboardFocus(window);
+    return true;
+}
+
+static void PS4_DestroyWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    if (window == PS4_fullscreen_window) {
+        PS4_fullscreen_window = NULL;
+    }
+}
+
+static void PS4_SetWindowSize(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    /* fixed: the screen's size */
+    SDL_SendWindowEvent(window, SDL_EVENT_WINDOW_RESIZED, PS4_SCREEN_W, PS4_SCREEN_H);
+}
+
+static bool PS4_SetWindowPosition(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_SendWindowEvent(window, SDL_EVENT_WINDOW_MOVED, 0, 0);
+    return true;
+}
+
+static SDL_FullscreenResult PS4_SetWindowFullscreen(SDL_VideoDevice *_this, SDL_Window *window,
+                                                    SDL_VideoDisplay *display, SDL_FullscreenOp fullscreen)
+{
+    return SDL_FULLSCREEN_SUCCEEDED;
+}
+
+static void PS4_ShowWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_SetKeyboardFocus(window);
+}
+
+static void PS4_HideWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+}
+
+/* ---- Vulkan ------------------------------------------------------------------------------------------------- */
+
+static bool PS4_Vulkan_LoadLibrary(SDL_VideoDevice *_this, const char *path)
+{
+    PFN_vkGetInstanceProcAddr gipa;
+    if (_this->vulkan_config.vkGetInstanceProcAddr) {
+        return true;
+    }
+    if (!SDL_PS4_GetVkGetInstanceProcAddr || !(gipa = (PFN_vkGetInstanceProcAddr)SDL_PS4_GetVkGetInstanceProcAddr())) {
+        return SDL_SetError("PS4: this application has no Vulkan driver linked in");
+    }
+    _this->vulkan_config.vkGetInstanceProcAddr = (SDL_FunctionPointer)gipa;
+    _this->vulkan_config.vkEnumerateInstanceExtensionProperties =
+        (SDL_FunctionPointer)gipa(VK_NULL_HANDLE, "vkEnumerateInstanceExtensionProperties");
+    _this->vulkan_config.loader_handle = (void *)gipa; /* statically linked: nothing to unload */
+    SDL_strlcpy(_this->vulkan_config.loader_path, "radv (static)", SDL_arraysize(_this->vulkan_config.loader_path));
+    return true;
+}
+
+static void PS4_Vulkan_UnloadLibrary(SDL_VideoDevice *_this)
+{
+    /* statically linked: keep the pointers, a later SDL_Vulkan_LoadLibrary finds them again */
+}
+
+static char const *const *PS4_Vulkan_GetInstanceExtensions(SDL_VideoDevice *_this, Uint32 *count)
+{
+    static const char *const extensions[] = { VK_KHR_SURFACE_EXTENSION_NAME, VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME };
+    if (count) {
+        *count = SDL_arraysize(extensions);
+    }
+    return extensions;
+}
+
+static bool PS4_Vulkan_CreateSurface(SDL_VideoDevice *_this, SDL_Window *window, VkInstance instance,
+                                     const struct VkAllocationCallbacks *allocator, VkSurfaceKHR *surface)
+{
+    PFN_vkGetInstanceProcAddr gipa = (PFN_vkGetInstanceProcAddr)_this->vulkan_config.vkGetInstanceProcAddr;
+    PFN_vkCreateHeadlessSurfaceEXT create;
+    VkHeadlessSurfaceCreateInfoEXT info;
+    VkResult result;
+
+    *surface = VK_NULL_HANDLE;
+    if (!gipa) {
+        return SDL_SetError("Vulkan is not loaded");
+    }
+    create = (PFN_vkCreateHeadlessSurfaceEXT)gipa(instance, "vkCreateHeadlessSurfaceEXT");
+    if (!create) {
+        return SDL_SetError(VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME " is not available");
+    }
+    SDL_zero(info);
+    info.sType = VK_STRUCTURE_TYPE_HEADLESS_SURFACE_CREATE_INFO_EXT;
+    result = create(instance, &info, allocator, surface);
+    if (result != VK_SUCCESS) {
+        return SDL_SetError("vkCreateHeadlessSurfaceEXT failed: %s", SDL_Vulkan_GetResultString(result));
+    }
+    return true;
+}
+
+static void PS4_Vulkan_DestroySurface(SDL_VideoDevice *_this, VkInstance instance, VkSurfaceKHR surface,
+                                      const struct VkAllocationCallbacks *allocator)
+{
+    PFN_vkGetInstanceProcAddr gipa = (PFN_vkGetInstanceProcAddr)_this->vulkan_config.vkGetInstanceProcAddr;
+    PFN_vkDestroySurfaceKHR destroy;
+    if (!gipa || !surface) {
+        return;
+    }
+    destroy = (PFN_vkDestroySurfaceKHR)gipa(instance, "vkDestroySurfaceKHR");
+    if (destroy) {
+        destroy(instance, surface, allocator);
+    }
+}
+
+static bool PS4_Vulkan_GetPresentationSupport(SDL_VideoDevice *_this, VkInstance instance,
+                                              VkPhysicalDevice physicalDevice, Uint32 queueFamilyIndex)
+{
+    return queueFamilyIndex == 0; /* the graphics queue family presents (the WSI's rule) */
+}
+
+/* ---- bootstrap ---------------------------------------------------------------------------------------------- */
+
+static void PS4_DeleteDevice(SDL_VideoDevice *device)
+{
+    SDL_free(device);
+}
+
+static SDL_VideoDevice *PS4_CreateDevice(void)
+{
+    SDL_VideoDevice *device = (SDL_VideoDevice *)SDL_calloc(1, sizeof(SDL_VideoDevice));
+    if (!device) {
+        return NULL;
+    }
+    device->VideoInit = PS4_VideoInit;
+    device->VideoQuit = PS4_VideoQuit;
+    device->PumpEvents = PS4_PumpEvents;
+    device->CreateSDLWindow = PS4_CreateWindow;
+    device->DestroyWindow = PS4_DestroyWindow;
+    device->SetWindowSize = PS4_SetWindowSize;
+    device->SetWindowPosition = PS4_SetWindowPosition;
+    device->SetWindowFullscreen = PS4_SetWindowFullscreen;
+    device->ShowWindow = PS4_ShowWindow;
+    device->HideWindow = PS4_HideWindow;
+    device->Vulkan_LoadLibrary = PS4_Vulkan_LoadLibrary;
+    device->Vulkan_UnloadLibrary = PS4_Vulkan_UnloadLibrary;
+    device->Vulkan_GetInstanceExtensions = PS4_Vulkan_GetInstanceExtensions;
+    device->Vulkan_CreateSurface = PS4_Vulkan_CreateSurface;
+    device->Vulkan_DestroySurface = PS4_Vulkan_DestroySurface;
+    device->Vulkan_GetPresentationSupport = PS4_Vulkan_GetPresentationSupport;
+    device->device_caps = VIDEO_DEVICE_CAPS_FULLSCREEN_ONLY;
+    device->free = PS4_DeleteDevice;
+    return device;
+}
+
+VideoBootStrap PRIVATE_bootstrap = {
+    PS4VID_DRIVER_NAME, "SDL PS4 video driver (VideoOut + Vulkan)",
+    PS4_CreateDevice,
+    NULL, /* no message boxes */
+    false
+};
+
+#endif /* SDL_VIDEO_DRIVER_PRIVATE && SDL_PLATFORM_PS4_HOMEBREW */

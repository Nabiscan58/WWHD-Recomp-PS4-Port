+/* PS4 homebrew: playback through sceAudioOut, the main port, 48 kHz float stereo in grains of 256 frames.
+   sceAudioOutOutput blocks until the port takes the next grain, which paces SDL's device thread. No recording. */
+#include "SDL_internal.h"
+
+#if defined(SDL_AUDIO_DRIVER_PRIVATE) && defined(SDL_PLATFORM_PS4_HOMEBREW)
+
+#include "../SDL_sysaudio.h"
+
+#include <orbis/AudioOut.h>
+
+#define PS4_AUDIO_FRAMES 256
+#define PS4_AUDIO_FORMAT_FLOAT_STEREO 4 /* ORBIS_AUDIO_OUT_PARAM_FORMAT_FLOAT_STEREO */
+#define PS4_AUDIO_ALREADY_INIT ((int)0x8026000E)
+#define PS4_NUM_BUFFERS 2
+
+/* libkernel (declared here: the toolchain's headers give no usable prototypes) */
+extern void *scePthreadSelf(void);
+extern int scePthreadSetprio(void *thread, int prio);
+
+struct SDL_PrivateAudioData
+{
+    int port;
+    Uint8 *rawbuf;
+    Uint8 *mixbufs[PS4_NUM_BUFFERS];
+    int next_buffer;
+};
+
+static bool PS4AUDIO_OpenDevice(SDL_AudioDevice *device)
+{
+    int r, i, mixlen;
+    int volume[2] = { 32768, 32768 }; /* 0 dB */
+
+    if (device->recording) {
+        return SDL_SetError("PS4: no audio recording");
+    }
+    device->hidden = (struct SDL_PrivateAudioData *)SDL_calloc(1, sizeof(*device->hidden));
+    if (!device->hidden) {
+        return false;
+    }
+    device->hidden->port = -1;
+
+    /* the main port takes exactly this; SDL converts whatever the application gives it */
+    device->spec.format = SDL_AUDIO_F32LE;
+    device->spec.channels = 2;
+    device->spec.freq = 48000;
+    device->sample_frames = PS4_AUDIO_FRAMES;
+    SDL_UpdatedAudioDeviceFormat(device);
+
+    r = sceAudioOutInit();
+    if (r != 0 && r != PS4_AUDIO_ALREADY_INIT) {
+        return SDL_SetError("sceAudioOutInit failed: %08x", (unsigned)r);
+    }
+    device->hidden->port = sceAudioOutOpen(0xFF /* the system user */, ORBIS_AUDIO_OUT_PORT_TYPE_MAIN, 0,
+                                           PS4_AUDIO_FRAMES, 48000, PS4_AUDIO_FORMAT_FLOAT_STEREO);
+    if (device->hidden->port < 0) {
+        return SDL_SetError("sceAudioOutOpen failed: %08x", (unsigned)device->hidden->port);
+    }
+    sceAudioOutSetVolume(device->hidden->port, 0x3 /* left and right */, volume);
+
+    mixlen = device->buffer_size * PS4_NUM_BUFFERS;
+    device->hidden->rawbuf = (Uint8 *)SDL_aligned_alloc(64, mixlen);
+    if (!device->hidden->rawbuf) {
+        return false;
+    }
+    SDL_memset(device->hidden->rawbuf, 0, mixlen);
+    for (i = 0; i < PS4_NUM_BUFFERS; i++) {
+        device->hidden->mixbufs[i] = device->hidden->rawbuf + i * device->buffer_size;
+    }
+    device->hidden->next_buffer = 0;
+    return true;
+}
+
+static bool PS4AUDIO_PlayDevice(SDL_AudioDevice *device, const Uint8 *buffer, int buffer_size)
+{
+    return sceAudioOutOutput(device->hidden->port, buffer) >= 0;
+}
+
+static bool PS4AUDIO_WaitDevice(SDL_AudioDevice *device)
+{
+    return true; /* PlayDevice blocks until the port takes the next grain */
+}
+
+static Uint8 *PS4AUDIO_GetDeviceBuf(SDL_AudioDevice *device, int *buffer_size)
+{
+    Uint8 *result = device->hidden->mixbufs[device->hidden->next_buffer];
+    device->hidden->next_buffer = (device->hidden->next_buffer + 1) % PS4_NUM_BUFFERS;
+    return result;
+}
+
+static void PS4AUDIO_CloseDevice(SDL_AudioDevice *device)
+{
+    if (device->hidden) {
+        if (device->hidden->port >= 0) {
+            sceAudioOutOutput(device->hidden->port, NULL); /* let the last grain finish */
+            sceAudioOutClose(device->hidden->port);
+            device->hidden->port = -1;
+        }
+        if (device->hidden->rawbuf) {
+            SDL_aligned_free(device->hidden->rawbuf);
+            device->hidden->rawbuf = NULL;
+        }
+        SDL_free(device->hidden);
+        device->hidden = NULL;
+    }
+}
+
+static void PS4AUDIO_ThreadInit(SDL_AudioDevice *device)
+{
+    /* above the game's threads (default 700), so a slow frame doesn't make the sound crackle */
+    scePthreadSetprio(scePthreadSelf(), 400);
+}
+
+static bool PS4AUDIO_Init(SDL_AudioDriverImpl *impl)
+{
+    impl->OpenDevice = PS4AUDIO_OpenDevice;
+    impl->PlayDevice = PS4AUDIO_PlayDevice;
+    impl->WaitDevice = PS4AUDIO_WaitDevice;
+    impl->GetDeviceBuf = PS4AUDIO_GetDeviceBuf;
+    impl->CloseDevice = PS4AUDIO_CloseDevice;
+    impl->ThreadInit = PS4AUDIO_ThreadInit;
+    impl->OnlyHasDefaultPlaybackDevice = true;
+    impl->HasRecordingSupport = false;
+    return true;
+}
+
+AudioBootStrap PRIVATEAUDIO_bootstrap = {
+    "ps4", "PS4 sceAudioOut", PS4AUDIO_Init, false, false
+};
+
+#endif /* SDL_AUDIO_DRIVER_PRIVATE && SDL_PLATFORM_PS4_HOMEBREW */
